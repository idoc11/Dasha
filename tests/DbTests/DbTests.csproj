<Project Sdk="Microsoft.NET.Sdk">
  <!-- Интеграционные тесты слоя данных и модели (без интерфейса).
       Запуск: dotnet run (нужна база simdb, см. sql/). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS8602;CS8604</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../SEO_LoadSimulator_v2/Model.cs" />
    <Compile Include="../../SEO_LoadSimulator_v2/Db.cs" />
    <Compile Include="Program.cs" />
    <PackageReference Include="Npgsql" Version="8.0.3" />
  </ItemGroup>
</Project>
